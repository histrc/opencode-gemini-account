{
  "manifest_version": 3,
  "name": "OpenCode Gemini Account Bridge",
  "version": "0.1.0",
  "description": "Connects the currently open Google AI Studio tab to the local OpenCode plugin.",
  "permissions": ["storage", "alarms"],
  "minimum_chrome_version": "120",
  "host_permissions": ["https://aistudio.google.com/*"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [{
    "matches": ["https://aistudio.google.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "OpenCode Gemini Bridge", "default_popup": "popup.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:37654"
  }
}
